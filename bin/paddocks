#!/usr/bin/env python3
"""Run Paddocks straight from a checkout, with nothing installed.

An installed copy gets the same command from the console script declared in
pyproject.toml; this shim exists so that clone-and-symlink keeps working.
"""

from __future__ import annotations

import sys
from pathlib import Path

# The package sits alongside bin/, not inside it.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from paddocks.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
